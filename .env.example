# ==============================================
# קובץ דוגמה למשתני סביבה — צוות דפי הנחיתה
# העתק קובץ זה ל-.env ומלא את הערכים האמיתיים.
# אין להעלות את .env ל-git (הוא מכיל סודות).
# ==============================================

# --- Claude / Anthropic API ---
# מפתח ה-API של Anthropic (משמש את כל הסוכנים)
ANTHROPIC_API_KEY=

# מזהה המודל שבו משתמשים כברירת מחדל
ANTHROPIC_MODEL=claude-opus-4-8

# --- איתי (המעצב) ---
# מפתח API של OpenAI ליצירת נכסים ויזואליים (סקיל gpt-image-gen, מודל gpt-image-2). חובה.
OPENAI_API_KEY=

# --- טל (הפרסום) ---
# טל מכין חבילות קמפיין בלבד ואינו מפרסם דרך API — לכן אין צורך במפתחות כרגע.
# לשלב עתידי (פרסום חי דרך API), הוסף כאן את המפתחות המתאימים:
# ADS_API_KEY=
# ANALYTICS_API_KEY=

# --- כללי ---
# סביבת הריצה: development / production
ENV=development
