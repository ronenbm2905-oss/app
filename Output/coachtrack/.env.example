# CoachTrack — משתני סביבה של Firebase Web SDK
# העתק לקובץ .env.local ומלא את הערכים מקונסולת Firebase:
# Project Settings → General → Your apps → Web app → firebaseConfig
#
# הערה: מפתחות אלה ציבוריים לפי עיצוב (הם נצרבים ל-build של הדפדפן).
# ההגנה האמיתית היא firestore.rules — לא הסתרת המפתח.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
