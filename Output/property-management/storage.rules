rules_version = '2';

// ============================================================================
// Storage — deny-by-default, שלושה תפקידים (מקביל ל-firestore.rules).
// מסמכים סרוקים (חוזה/ערבים/קבלות) הם PII רגיש (תיקון 13).
//
//   owner       — קריאה/כתיבה מלאה תחת owners/{ownerId}/**.
//   maintenance — קריאה/כתיבה **רק** תחת owners/{ownerId}/tickets/{ticketId}/**
//                 אם הוא ה-assignee של אותה תקלה (firestore.get על מסמך התקלה).
//                 כאן הוא מעלה תמונות/קבלות מהשטח.
//   tenant      — קריאה **בלבד** תחת owners/{ownerId}/documents/{docId}/**
//                 אם הוא ה-tenant המקושר למסמך (firestore.get → tenant.userId).
//
// הבידוד ב-rules עצמם. סקופ נוכחי: ישראל-בלבד (החלטת המשתמש).
// בפרוסה 1 לא הועלו קבצים בפועל; ההעלאה נפתחת אחרי שער עדי (הצפנה/החלטת אחסון).
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }
    function ticketData(ownerId, ticketId) {
      return firestore.get(/databases/(default)/documents/owners/$(ownerId)/tickets/$(ticketId)).data;
    }
    function tenantData(ownerId, tenantId) {
      return firestore.get(/databases/(default)/documents/owners/$(ownerId)/tenants/$(tenantId)).data;
    }
    function docMeta(ownerId, docId) {
      return firestore.get(/databases/(default)/documents/owners/$(ownerId)/documents/$(docId)).data;
    }

    // -- תמונות/קבלות של תקלה: owner מלא; assignee קריאה+כתיבה --
    match /owners/{ownerId}/tickets/{ticketId}/{allPaths=**} {
      allow read, write: if isOwner(ownerId)
        || (isSignedIn() && ticketData(ownerId, ticketId).assigneeUserId == request.auth.uid);
    }

    // -- מסמכים סרוקים: owner מלא; הדייר המקושר קריאה בלבד --
    match /owners/{ownerId}/documents/{docId}/{allPaths=**} {
      allow write: if isOwner(ownerId);
      allow read: if isOwner(ownerId)
        || (
          isSignedIn()
          && docMeta(ownerId, docId).tenantId != null
          && tenantData(ownerId, docMeta(ownerId, docId).tenantId).userId == request.auth.uid
        );
    }

    // -- כל שאר הנתיבים תחת בעלים: owner בלבד --
    match /owners/{ownerId}/{allPaths=**} {
      allow read, write: if isOwner(ownerId);
    }

    // כל שאר הנתיבים — חסום מפורשות.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
