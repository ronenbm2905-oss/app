# Firebase Web config — העתק לקובץ .env (שלא נכנס ל-git) ומלא את הערכים
# מ-Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration.
# בלי הקובץ הזה האפליקציה רצה אוטומטית במצב מקומי (localStorage).

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
