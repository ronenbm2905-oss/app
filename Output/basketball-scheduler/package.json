{
  "name": "basketball-scheduler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:offline": "vite --mode offline",
    "dev:saas": "vite --mode saas",
    "build:saas": "vite build --mode saas",
    "deploy:saas": "node ./node_modules/firebase-tools/lib/bin/firebase.js deploy --project saas",
    "test:rules": "firebase emulators:exec --only firestore --project rules-test \"node scripts/rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "^10.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "firebase-tools": "^15.25.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4"
  }
}
