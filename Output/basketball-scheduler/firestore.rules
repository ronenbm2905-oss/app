rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Permission model (allowlist) ----
    // Every club document holds two email allowlists:
    //   admins[]  — editors: may read AND write.
    //   members[] — viewers: may read only.
    // A signed-in user whose Google email is in NEITHER list has NO access at
    // all (read is denied), so club data is never exposed to arbitrary Google
    // accounts. This mirrors the write model that was already admin-only.
    //
    // Multi-club note: the {clubId} wildcard already scopes every rule to a single
    // club document, so one deployment serving many clubs needs no change here —
    // each club's allowlists govern only its own document.
    //
    // IMPORTANT — store allowlist entries in LOWERCASE. The token side is lowercased
    // below, but rules cannot lowercase the stored list, so an entry like
    // "Ronen@Gmail.com" will never match. The client compares case-insensitively, so
    // a mixed-case entry shows edit buttons while every write is rejected.

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn() &&
        'admins' in resource.data &&
        authEmail() in resource.data.admins;
    }

    function isMember() {
      return signedIn() &&
        'members' in resource.data &&
        authEmail() in resource.data.members;
    }

    // Operators of the service itself (not of any one club). Kept in a document the
    // clients never read, and edited only from the Firebase console.
    function isSuperAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/config/global) &&
        authEmail() in get(/databases/$(database)/documents/config/global).data.superAdmins;
    }

    match /config/global {
      allow read: if isSuperAdmin();
      allow write: if false; // console only — never writable from the app
    }

    match /clubs/{clubId} {
      // Read limited to the allowlist (admins or members) — not any signed-in user.
      allow read: if isAdmin() || isMember();
      // Changes to an existing club: its own admins only.
      //
      // The same non-empty `admins` guard as `create`, and for the same reason — now that
      // the club edits its own allowlist from the settings screen rather than from the
      // Firebase console. `isAdmin()` reads the STORED list, so a club that writes an
      // empty one can never be read or written by anyone again, and a service operator is
      // not a way back: this block grants a super-admin nothing. The screen refuses to
      // remove the last manager; this refuses it at the layer that actually decides.
      allow update: if isAdmin() &&
        request.resource.data.admins is list &&
        request.resource.data.admins.size() > 0;
      allow delete: if isAdmin();
      // Creating a NEW club is a service-operator action. It must arrive with at least
      // one admin: `isAdmin()` reads the *existing* document, so a club created with an
      // empty admins[] could never be read or written by anyone again.
      allow create: if isSuperAdmin() &&
        request.resource.data.admins is list &&
        request.resource.data.admins.size() > 0;
    }

    // ---- Parent portal ----
    // Parents must NEVER be able to read clubs/{clubId}: it holds players' names, phone
    // numbers and dates of birth (minors), coaches' phones, and the allowlists. They read
    // only the published projection below, which carries the schedule and nothing else.
    //
    // The helpers above cannot be reused here: they read `resource.data`, which inside a
    // subcollection is the SUBCOLLECTION document, not the club. These fetch the club
    // document explicitly — a subtle difference that would otherwise look correct and
    // fail only at runtime.

    // Every field read here is guarded for existence first. Reading a field that is not
    // on the document is an ERROR in rules, not `false` — and an error fails the whole
    // expression, including the `||` branch that would have granted access. A club
    // created with only `admins` (no `members` yet) therefore locked its own parents
    // out of the portal, while looking like a permissions problem on their side.
    function clubData(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data;
    }
    function isClubStaff(clubId) {
      return signedIn() && (
        ('admins' in clubData(clubId) && authEmail() in clubData(clubId).admins) ||
        ('members' in clubData(clubId) && authEmail() in clubData(clubId).members)
      );
    }
    function isClubAdmin(clubId) {
      return signedIn() &&
        'admins' in clubData(clubId) &&
        authEmail() in clubData(clubId).admins;
    }
    // ---- A coach's own writing ----
    //
    // Records a coach authors about their own work. Every one carries `authorEmail`, and
    // that field is the only thing a rule can match a signed-in person against — `author`
    // beside it is a display name.
    //
    // These helpers sit beside the club-scoped ones below rather than reusing `isAdmin()`
    // and `isMember()` above: those read `resource.data`, which inside a subcollection is
    // the SUBCOLLECTION document, not the club. That difference looks like nothing and
    // fails only at runtime.
    //
    // `authEmail()` is already lower-cased, and the client writes `authorEmail`
    // lower-cased too (see utils/access.js). The comparison is exact, so a capital letter
    // on either side locks a coach out of their own writing with nothing on screen to
    // explain it.
    function ownsExisting() {
      return signedIn() &&
        'authorEmail' in resource.data &&
        resource.data.authorEmail == authEmail();
    }
    function ownsIncoming() {
      return signedIn() &&
        'authorEmail' in request.resource.data &&
        request.resource.data.authorEmail == authEmail();
    }

    // A coach reads and writes only their own records; the club's manager reads all of
    // them, and may update one without owning it — marking a note read is the manager's
    // job, not the author's.
    //
    // A collection LISTEN is refused outright unless the query is provably inside the
    // rule, so the client has to filter by `authorEmail` for a coach. See
    // hooks/useGameNotes.js — get this wrong and the symptom is an empty screen, not a
    // missing record.
    function ownRead(clubId) {
      return isClubAdmin(clubId) || (isClubStaff(clubId) && ownsExisting());
    }
    function ownCreate(clubId) {
      return isClubAdmin(clubId) || (isClubStaff(clubId) && ownsIncoming());
    }
    function ownChange(clubId) {
      return isClubAdmin(clubId) || (isClubStaff(clubId) && ownsExisting() && ownsIncoming());
    }

    // Notes a coach writes after a game. Their own documents rather than fields on the
    // club document: free text per game is the first thing here that grows without bound,
    // and the club document has a 1 MiB ceiling it already fits a whole season into.
    match /clubs/{clubId}/gameNotes/{gameKey} {
      allow read: if ownRead(clubId);
      allow create: if ownCreate(clubId);
      allow update: if ownChange(clubId);
      allow delete: if isClubAdmin(clubId) || (isClubStaff(clubId) && ownsExisting());
    }

    function portalUser() {
      return get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data;
    }
    function isPortalMemberOf(clubId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid)) &&
        'clubId' in portalUser() &&
        portalUser().clubId == clubId;
    }

    // The join code this parent used for this specific team, or "" if they have none.
    function storedCodeFor(teamId) {
      return 'teams' in portalUser() && teamId in portalUser().teams
        ? portalUser().teams[teamId]
        : "";
    }

    // Whether that code is STILL a live code for that team.
    //
    // This is what makes rotating a leaked code an actual revocation. Membership used to
    // be a permanent fact: `isPortalMemberOf` asked only which club the parent belonged
    // to, so replacing a code stopped new joins and removed nobody. A manager who
    // rotated a code after it spread through a WhatsApp group believed they had cut
    // access off, and had not — while the settings screen told them the old code had
    // stopped working.
    //
    // Checking the code on every read costs two extra document gets. That is the price
    // of the manager's belief being true.
    function codeStillLiveFor(clubId, teamId) {
      return storedCodeFor(teamId) != "" &&
        exists(/databases/$(database)/documents/clubs/$(clubId)/joinCodes/$(storedCodeFor(teamId))) &&
        get(/databases/$(database)/documents/clubs/$(clubId)/joinCodes/$(storedCodeFor(teamId))).data.teamId == teamId;
    }

    // Club-level part of a published week: the club's name, its legal contact details,
    // the holidays, and the team NAMES. No session, no game, no player — nothing that
    // says who trains where. Any parent of the club may read it; it is what lets the
    // portal name the club and show a team switcher.
    match /clubs/{clubId}/published/{weekOf} {
      allow read: if isClubStaff(clubId) || isPortalMemberOf(clubId);
      allow write: if isClubAdmin(clubId);
    }

    // One team's week. The team id is a path segment rather than part of a composite
    // document id precisely so this rule can name it: rules cannot split a string, so
    // "{weekOf}__{teamId}" would have left the check no way to know which team it was
    // looking at, and the boundary would have stayed where it was — in the portal's
    // rendering, which is not a boundary at all.
    match /clubs/{clubId}/published/{weekOf}/teams/{teamId} {
      allow read: if isClubStaff(clubId) ||
        (isPortalMemberOf(clubId) && codeStillLiveFor(clubId, teamId));
      allow write: if isClubAdmin(clubId);
    }

    // Code → team lookup, used once when a parent joins.
    // `get` only: a signed-in user may fetch a code they already know, but `list` stays
    // denied so nobody can enumerate the collection and harvest every team's code.
    match /clubs/{clubId}/joinCodes/{code} {
      allow get: if signedIn();
      allow list: if isClubAdmin(clubId);
      allow write: if isClubAdmin(clubId);
    }

    // The parent's own account↔team link. Deliberately holds no child's name and no
    // player record — the account belongs to the adult, and it points at a TEAM.
    //
    // This document IS the portal's access control: `isPortalMemberOf` above trusts its
    // clubId. So the write rules must prove the writer actually holds a join code — an
    // earlier version only type-checked the fields, which let ANY signed-in Google account
    // write itself into any club and read that club's published schedules.

    // The team unlocked by the join code presented in this very write.
    function unlockedTeam() {
      return get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)/joinCodes/$(request.resource.data.joinCode)).data.teamId;
    }
    function presentsValidCode() {
      return request.resource.data.clubId is string &&
        request.resource.data.joinCode is string &&
        // `teams` maps teamId → the code that unlocked it. It replaced a `teamIds` list
        // plus a single `joinCode`, which could not express "this team was unlocked by
        // that code": a parent who joined twice stored only the LAST code, so rotating
        // the first child's code revoked nothing. Access is per team, so the proof of
        // access has to be per team too.
        request.resource.data.teams is map &&
        request.resource.data.teams.size() > 0 &&
        request.resource.data.teams.size() <= 10 &&
        exists(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)/joinCodes/$(request.resource.data.joinCode)) &&
        // The entry being added must record the code actually presented — otherwise a
        // parent could name a live code they do not hold and keep access to a team whose
        // own code was replaced.
        request.resource.data.teams[unlockedTeam()] == request.resource.data.joinCode;
    }

    match /portalUsers/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;

      // First join: exactly the one team the code unlocks.
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        presentsValidCode() &&
        request.resource.data.teams.keys() == [unlockedTeam()];

      // A parent with a second child joins again. Within the same club they may add
      // ONLY the team the newly presented code unlocks — not an arbitrary team id — and
      // may not silently rewrite the code recorded against a team they already hold.
      // Presenting a code for a different club resets the link to that club alone:
      // one account is linked to one club at a time.
      allow update: if signedIn() &&
        request.auth.uid == uid &&
        presentsValidCode() &&
        // Same existence-guard discipline as above: a link document written before these
        // rules existed may be missing a field, and reading it would error out into a
        // denial the parent cannot act on. Treat "can't tell" as "start fresh" — which
        // is also how a document still carrying the old teamIds shape is handled.
        ('clubId' in resource.data && 'teams' in resource.data &&
         request.resource.data.clubId == resource.data.clubId
          ? request.resource.data.teams.keys().toSet()
              .difference(resource.data.teams.keys().toSet())
              .hasOnly([unlockedTeam()])
          : request.resource.data.teams.keys() == [unlockedTeam()]);
    }
  }
}
