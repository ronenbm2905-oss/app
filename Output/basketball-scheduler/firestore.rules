rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Permission model (allowlist) ----
    // Every club document holds two email allowlists:
    //   admins[]  — editors: may read AND write.
    //   members[] — viewers: may read only.
    // A signed-in user whose Google email is in NEITHER list has NO access at
    // all (read is denied), so club data is never exposed to arbitrary Google
    // accounts. This mirrors the write model that was already admin-only.

    function isAdmin() {
      return request.auth != null &&
        'admins' in resource.data &&
        request.auth.token.email in resource.data.admins;
    }

    function isMember() {
      return request.auth != null &&
        'members' in resource.data &&
        request.auth.token.email in resource.data.members;
    }

    match /clubs/{clubId} {
      // Read limited to the allowlist (admins or members) — not any signed-in user.
      allow read: if isAdmin() || isMember();
      // Write limited to admins only.
      allow write: if isAdmin();
    }

    // Notes a coach writes after a game, one document per game.
    //
    // The helpers above cannot be reused here: they read `resource.data`, which inside a
    // subcollection is the NOTE, not the club — a difference that reads as correct and
    // fails only at runtime. These fetch the club document explicitly, and guard every
    // field for existence, because reading a field that is not there is an ERROR in rules
    // rather than false, and an error denies the whole request.
    function clubOf(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data;
    }
    function isClubAdmin(clubId) {
      return request.auth != null &&
        'admins' in clubOf(clubId) &&
        request.auth.token.email in clubOf(clubId).admins;
    }
    function isClubMember(clubId) {
      return request.auth != null &&
        'members' in clubOf(clubId) &&
        request.auth.token.email in clubOf(clubId).members;
    }

    // ---- Ownership of a coach's own writing ----
    // Every note and plan carries `authorEmail`, lower-cased, and it is the only thing a
    // rule can match a signed-in person against — `author` is a display name. Lower-casing
    // matters: rules compare strings exactly, so a capital letter in a coach's address
    // would lock them out of their own writing with nothing on screen to explain why.
    function myEmail() {
      return request.auth != null && 'email' in request.auth.token
        ? request.auth.token.email.lower()
        : '';
    }
    function ownsExisting() {
      return myEmail() != '' &&
        'authorEmail' in resource.data &&
        resource.data.authorEmail == myEmail();
    }
    function ownsIncoming() {
      return myEmail() != '' &&
        'authorEmail' in request.resource.data &&
        request.resource.data.authorEmail == myEmail();
    }

    // A coach reads and writes only their own records; the professional manager reads all
    // of them, and may update one without owning it — marking a note as read is his job,
    // not the author's.
    //
    // A collection listen is refused outright unless the QUERY is provably inside the rule,
    // so the client has to filter by authorEmail for a coach. See hooks/useGameNotes.js.
    function canRead(clubId) {
      return isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting());
    }
    function canCreate(clubId) {
      return isClubAdmin(clubId) || (isClubMember(clubId) && ownsIncoming());
    }
    function canChange(clubId) {
      return isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting() && ownsIncoming());
    }

    // The club's training-plan form, one document per session.
    match /clubs/{clubId}/trainingPlans/{sessionId} {
      allow read: if canRead(clubId);
      allow create: if canCreate(clubId);
      allow update: if canChange(clubId);
      allow delete: if isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting());
    }

    // The club's shared library of drill videos.
    //
    // NOTE the read rule: any club member, NOT `canRead`. `canRead` requires ownership,
    // which is right for a coach's private notes and exactly wrong here — it would give
    // every coach a library containing only their own entries. Writing stays owner-scoped,
    // so a coach curates what they added and the manager can remove anything.
    //
    // The client listener must be unscoped to match. See hooks/useVideos.js.
    match /clubs/{clubId}/videos/{videoId} {
      allow read: if isClubAdmin(clubId) || isClubMember(clubId);
      allow create: if canCreate(clubId);
      allow update: if canChange(clubId);
      allow delete: if isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting());
    }

    // Notes a coach writes after a game.
    match /clubs/{clubId}/gameNotes/{gameKey} {
      allow read: if canRead(clubId);
      allow create: if canCreate(clubId);
      allow update: if canChange(clubId);
      allow delete: if isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting());
    }

    // A coach's half-season note on a player's progress, one document per player per half:
    // clubs/{id}/playerProgress/{playerId}__{period}.
    //
    // The same block as trainingPlans, and that is the point: the requirement — "the
    // manager and the coach who wrote it, nobody else" — is the literal reading of
    // `canRead`. Another coach does not see it because the RULE says so, not because a
    // screen hides it. Note the contrast with `videos` above, which deliberately does NOT
    // use canRead: there the library is shared, here it must not be.
    //
    // What this block does NOT enforce: that a coach only writes about players in their own
    // squads. `teams` and `players` are arrays of maps on the club document, and a rule
    // cannot search inside them. A coach could stamp a note onto another squad's player —
    // only they and the manager would ever see it, and the manager's screen shows which
    // squad it was filed under, so it is visible rather than silent. Enforced in the UI.
    match /clubs/{clubId}/playerProgress/{progressId} {
      allow read: if canRead(clubId);
      allow create: if canCreate(clubId);
      allow update: if canChange(clubId);
      allow delete: if isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting());
    }

    // Proposals filed by the nightly federation sync, one per day.
    //
    // Managers only — a coach has nothing to decide about an import, and the proposal
    // names every fixture in the club. The nightly job writes here with a service account,
    // which bypasses these rules entirely; this block governs the app, whose only write is
    // marking a proposal approved or rejected after a person has looked at it.
    match /clubs/{clubId}/pendingImports/{importId} {
      allow read, write: if isClubAdmin(clubId);
    }

    // Cup fixtures found on the federation site, filed by scripts/scan-cups.mjs for a
    // manager to accept. Same shape as pendingImports and for the same reason: nothing
    // automated writes to the club document, so the proposal needs somewhere of its own.
    match /clubs/{clubId}/cupScans/{scanId} {
      allow read, write: if isClubAdmin(clubId);
    }

    // The manager's own spreadsheets — the fixed hall-slot sheet and anything of that shape.
    //
    // MANAGERS ONLY, BOTH WAYS. This is the first collection in the club with exactly one
    // audience: not shared like the video library, not owner-scoped like a coach's notes.
    // The screen is hidden from a coach as well, but THIS is the boundary — App.jsx:62 has
    // said since the beginning that a hidden tab is not a security one.
    //
    // The club holds no files anywhere: a sheet arrives as a workbook read in the browser and
    // is stored as its rows. Note the shape in utils/sheetGrid.js — each row is a map holding
    // a "cells" array, because Firestore cannot nest an array directly inside an array.
    match /clubs/{clubId}/sheets/{sheetId} {
      allow read, write: if isClubAdmin(clubId);
    }

    // "The nightly job ran, and this is what it found" — clubs/{id}/sync/nightly.
    //
    // READ-ONLY FROM THE APP, AND THAT IS THE POINT. The only writer is the sync itself,
    // through the service account, which does not pass through these rules at all. A
    // browser that could write here could report a dead job as healthy, which is the exact
    // failure the document exists to make impossible.
    match /clubs/{clubId}/sync/{docId} {
      allow read: if isClubAdmin(clubId);
      allow write: if false;
    }

    // One row per device: clubs/{id}/pushTokens/{token}
    //
    // NOTE THE FIELD NAME. Ownership here is measured by `authorEmail`, exactly as in every
    // other collection — if the row were stored under `email`, this block would review
    // cleanly, look right, and fail only at run time: the coach could not delete their own
    // row, which means they could not turn notifications OFF. That is the warning already
    // written at the top of this file, and this is where it would have cost the most.
    //
    // Read is OWNER-ONLY, not `isClubMember`. A single device row is not sensitive; the
    // collection is — it is a map of which coach holds which devices, next to their email
    // addresses, and no coach has any reason to read another's. The sending process runs
    // with a service account and bypasses these rules entirely, so nothing here is in its
    // way; this block exists solely to constrain the browser.
    match /clubs/{clubId}/pushTokens/{token} {
      // The shared helpers, exactly as trainingPlans uses them. These four lines were
      // written out by hand instead, and the admin arm went missing from create and
      // update — so the three admins, who are NOT in members[], could not register their
      // own device. Coaches could. Which meant the only person who tested it was the
      // only kind of person it did not work for.
      allow read: if canRead(clubId);
      allow create: if canCreate(clubId);
      allow update: if canChange(clubId);
      allow delete: if isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting());
    }

    // The ONLY document in this project that anyone on the internet may read — and the
    // reason it exists is so that nobody outside the club ever needs read access to the
    // club document, which carries the name, phone and birth date of every child in it.
    // Firestore has no field-level permissions, so "just the sessions" is not a rule that
    // can be written. A minimal copy is published instead.
    //
    // The token in the path IS the access control: twelve characters, per team, replaceable
    // in one click. What it protects is a team's training times — the same thing the coach
    // already posts in that team's WhatsApp group — and no person's data except the name of
    // the coach who signed a message.
    match /clubs/{clubId}/boards/{token} {
      // GET, not READ. `read` covers get AND list, and a list would hand over every team's
      // board in one query to anyone who knows the club id — which is in the published
      // bundle. The token would then be protecting nothing at all. Listing belongs to the
      // manager, whose browser refreshes the boards after each save.
      allow get: if true;
      allow list: if isClubAdmin(clubId);
      allow create, delete: if isClubAdmin(clubId);
      allow update: if isClubAdmin(clubId);
      // A coach writes the message on a board and NOTHING else. Without this clause the
      // only way to let them post one would be write access to the board itself — a second
      // version of the schedule, edited by hand, that nobody could trace back to the club's
      // own data.
      allow update: if isClubMember(clubId)
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['message', 'updatedAt']);
    }

    // A DEVICE subscribed to a team board, so a parent is told when the schedule moves.
    //
    // Nobody signs in, and that is the whole design. The row holds a push token, the board
    // it follows, and a timestamp — no name, no email, no identity of any kind. It is the
    // difference between knowing WHO to tell and knowing WHERE to send, and only the second
    // one is needed. It is also why this needed no accounts, no codes and no consent chain.
    match /clubs/{clubId}/boardSubs/{fcmToken} {
      // The push token is the capability: holding it is what lets a device read or remove
      // its own subscription. Listing stays with the manager — one query over this
      // collection is a census of how many families follow each squad.
      allow get, delete: if true;
      allow list: if isClubAdmin(clubId);
      // Writable without a sign-in, but not writable freely: the row must be keyed by the
      // token it carries, and must follow a board that actually exists. Without the second
      // check this collection accepts anything anyone cares to put in it.
      allow create, update: if request.resource.data.fcmToken == fcmToken
                            && exists(/databases/$(database)/documents/clubs/$(clubId)/boards/$(request.resource.data.boardToken));
    }

    // A player's own account — the first people here who are neither staff nor coaches.
    //
    // The FIRST login is the whole problem: a child signs in with Google and nothing about
    // that identity says which of the club's players they are. The browser must not be the
    // one to answer, so a one-time code does, and THESE RULES check it. A claim written by
    // hand with someone else's playerId is refused here, not in the app.
    match /clubs/{clubId}/claimCodes/{code} {
      // Knowing the code IS the proof, exactly as with a board token — so a single document
      // can be fetched by anyone who holds it, and the collection can never be listed. The
      // difference between `get` and `list` is the entire protection: without it, one query
      // would hand over every code in the club.
      allow get: if true;
      allow list: if isClubAdmin(clubId);
      allow write: if isClubAdmin(clubId);
    }

    match /clubs/{clubId}/playerAccounts/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isClubAdmin(clubId));
      allow list: if isClubAdmin(clubId);

      // Three things at once, and none of them is optional:
      //   1. the row is keyed by the caller's own uid, so nobody writes an account for
      //      anyone else;
      //   2. the code they present exists;
      //   3. that code names the player they claim to be.
      // (3) is what makes the code a proof rather than a formality — without it a child
      // could hold a real code and still file themselves as a different player.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && exists(/databases/$(database)/documents/clubs/$(clubId)/claimCodes/$(request.resource.data.code))
                    && get(/databases/$(database)/documents/clubs/$(clubId)/claimCodes/$(request.resource.data.code)).data.playerId
                       == request.resource.data.playerId;

      // Never edited. A link is made once and otherwise removed — an account that can be
      // rewritten is an account that can be pointed at a different player later.
      allow update: if false;
      allow delete: if (request.auth != null && request.auth.uid == uid) || isClubAdmin(clubId);
    }

    // Finished months moved out of the club document, one per month.
    //
    // Read is the same audience as the club document itself — admins AND members — and
    // that is on purpose: this is the club's own schedule, just older. Making it
    // admin-only would mean a coach could read a session in September and be refused the
    // identical row in July, which is a rule that protects nothing and confuses everyone.
    //
    // Write is managers only, like the club document it came out of.
    //
    // Update is allowed, and refusing it would have been a trap rather than a control. The
    // archive document is written BEFORE the club document is trimmed, so a failure in
    // between leaves the month archived but not yet recorded in the index — which means
    // the screen offers it again, and the retry is an UPDATE. A create-only rule would
    // make that retry fail for ever, in exactly the situation where recovery matters.
    //
    // Delete stays closed. Removing a season is a deliberate act that belongs in the
    // console with the deletion procedure open, not one API call from a weekly screen.
    match /clubs/{clubId}/archive/{month} {
      allow read: if isClubAdmin(clubId) || isClubMember(clubId);
      allow create, update: if isClubAdmin(clubId);
      allow delete: if false;
    }
  }
}
