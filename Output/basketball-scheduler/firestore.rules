rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Permission model (allowlist) ----
    // Every club document holds two email allowlists:
    //   admins[]  — editors: may read AND write.
    //   members[] — viewers: may read only.
    // A signed-in user whose Google email is in NEITHER list has NO access at
    // all (read is denied), so club data is never exposed to arbitrary Google
    // accounts. This mirrors the write model that was already admin-only.

    function isAdmin() {
      return request.auth != null &&
        'admins' in resource.data &&
        request.auth.token.email in resource.data.admins;
    }

    function isMember() {
      return request.auth != null &&
        'members' in resource.data &&
        request.auth.token.email in resource.data.members;
    }

    match /clubs/{clubId} {
      // Read limited to the allowlist (admins or members) — not any signed-in user.
      allow read: if isAdmin() || isMember();
      // Write limited to admins only.
      allow write: if isAdmin();
    }

    // Notes a coach writes after a game, one document per game.
    //
    // The helpers above cannot be reused here: they read `resource.data`, which inside a
    // subcollection is the NOTE, not the club — a difference that reads as correct and
    // fails only at runtime. These fetch the club document explicitly, and guard every
    // field for existence, because reading a field that is not there is an ERROR in rules
    // rather than false, and an error denies the whole request.
    function clubOf(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data;
    }
    function isClubAdmin(clubId) {
      return request.auth != null &&
        'admins' in clubOf(clubId) &&
        request.auth.token.email in clubOf(clubId).admins;
    }
    function isClubMember(clubId) {
      return request.auth != null &&
        'members' in clubOf(clubId) &&
        request.auth.token.email in clubOf(clubId).members;
    }

    // ---- Ownership of a coach's own writing ----
    // Every note and plan carries `authorEmail`, lower-cased, and it is the only thing a
    // rule can match a signed-in person against — `author` is a display name. Lower-casing
    // matters: rules compare strings exactly, so a capital letter in a coach's address
    // would lock them out of their own writing with nothing on screen to explain why.
    function myEmail() {
      return request.auth != null && 'email' in request.auth.token
        ? request.auth.token.email.lower()
        : '';
    }
    function ownsExisting() {
      return myEmail() != '' &&
        'authorEmail' in resource.data &&
        resource.data.authorEmail == myEmail();
    }
    function ownsIncoming() {
      return myEmail() != '' &&
        'authorEmail' in request.resource.data &&
        request.resource.data.authorEmail == myEmail();
    }

    // A coach reads and writes only their own records; the professional manager reads all
    // of them, and may update one without owning it — marking a note as read is his job,
    // not the author's.
    //
    // A collection listen is refused outright unless the QUERY is provably inside the rule,
    // so the client has to filter by authorEmail for a coach. See hooks/useGameNotes.js.
    function canRead(clubId) {
      return isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting());
    }
    function canCreate(clubId) {
      return isClubAdmin(clubId) || (isClubMember(clubId) && ownsIncoming());
    }
    function canChange(clubId) {
      return isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting() && ownsIncoming());
    }

    // The club's training-plan form, one document per session.
    match /clubs/{clubId}/trainingPlans/{sessionId} {
      allow read: if canRead(clubId);
      allow create: if canCreate(clubId);
      allow update: if canChange(clubId);
      allow delete: if isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting());
    }

    // Notes a coach writes after a game.
    match /clubs/{clubId}/gameNotes/{gameKey} {
      allow read: if canRead(clubId);
      allow create: if canCreate(clubId);
      allow update: if canChange(clubId);
      allow delete: if isClubAdmin(clubId) || (isClubMember(clubId) && ownsExisting());
    }
  }
}
