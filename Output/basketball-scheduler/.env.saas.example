# ---------------------------------------------------------------------------
# SaaS / development environment — the NEW Firebase project, NOT Kiryat Ono's.
#
# Copy this file to ".env.saas" and fill in the values from the new project:
#   Firebase Console → Project settings → General → "Your apps" → SDK setup → Config
#
# Used by:  npm run build:saas   /   npm run dev:saas     (vite --mode saas)
# The production .env (Kiryat Ono) is never read in this mode.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Default club for the bare "/" route in this environment. Use a demo club,
# never "main", so development can never point at production data by accident.
VITE_CLUB_ID=demo
