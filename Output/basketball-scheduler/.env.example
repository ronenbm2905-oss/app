# ---------------------------------------------------------------------------
# Firebase configuration.
# Copy this file to ".env" and fill in the values from your Firebase project:
#   Firebase Console → Project settings → General → "Your apps" → SDK setup → Config
# As long as .env is missing/empty, the app runs in LOCAL MODE (localStorage only).
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: the Firestore document id for your club. Defaults to "main".
VITE_CLUB_ID=main
