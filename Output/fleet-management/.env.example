# העתק ל-.env ומלא מ-Firebase Console → Project settings → Your apps → Web app.
# מפתחות ה-Web ציבוריים ממילא — ההגנה האמיתית היא firestore.rules / storage.rules.
# ⚠️ הערכים נקראים בזמן build (Vite) — כל שינוי מחייב `npm run build` מחדש.
# כל עוד הקובץ לא קיים, האפליקציה רצה במצב מקומי (localStorage) בלי ענן.

# פיתוח בלבד: VITE_FB_USE_EMULATOR=1 בסביבת התהליך (לא בקובץ!) מפנה את
# האפליקציה לאמולטור המקומי במקום לפרויקט האמיתי. פועל רק ב-`npm run dev`;
# בכל build הדגל כבוי מילולית. ראה README → "בדיקת מסלול הענן מקומית".

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# ---------------------------------------------------------------------------
# VITE_FLEET_ORG_ID — מזהה הארגון, **קבוע בזמן build**.
#
# הדפוס מ-Output/basketball-scheduler (VITE_CLUB_ID), שחי בפרודקשן: כל
# המשתמשים פותחים את **אותו** מסמך orgs/{id}, והגישה נשלטת ע"י allowlist של
# מיילים בתוך המסמך (org.adminEmails) ולא ע"י מזהה שנגזר מהמשתמש.
#
# ⚠️ עד 17.8 המזהה היה `user.uid` קשיח (useData.js:63), ולכן כל מי שלא הקים
# את הארגון בעצמו קיבל **מסך הקמה ראשונית** — וכך אדמין שני היה יוצר ארגון
# שני נפרד עם אפס רכבים. זה קרה בפועל.
#
# ⚠️ הערך הוא מזהה הארגון **הקיים** (ה-uid של מי שהקים אותו), ולכן **אין
# הגירת נתונים** — הרכבים והנהגים נשארים במקומם בדיוק.
#
# ריק = התקנה חדשה: הקליינט נופל חזרה ל-uid של המשתמש המחובר, וכך המשתמש
# הראשון עוד יכול להקים ארגון (status 'bootstrap' → מסך ההקמה).
#
# ⚠️ נקרא בזמן build — כל שינוי מחייב `npm run build` מחדש לפני deploy.
# ---------------------------------------------------------------------------
VITE_FLEET_ORG_ID=
