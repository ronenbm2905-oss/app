# ============================================================================
# העתיקו לקובץ בשם `.env` ומלאו. **`.env` לעולם לא נכנס ל-git.**
#
# מפתחות ה-Web של Firebase הם ציבוריים מעצם טבעם — הם מוטמעים בכל build
# ונשלחים לכל דפדפן. **ההגנה האמיתית היא `firestore.rules` + App Check**,
# לא סודיות המפתח. אל תתפתו "להסתיר" אותם; תתמקדו ב-rules.
#
# ⚠️ `VITE_*` נקראים בזמן **build**. כל שינוי כאן מחייב `npm run build` מחדש,
#    אחרת ה-dist ממשיך לשאת את הקונפיג הישן.
# ============================================================================

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# ----------------------------------------------------------------------------
# App Check (עדי R-5 — **חובה לפני go-live**)
#
# מפתח האתר של reCAPTCHA v3, מתוך Firebase Console → App Check.
# בלעדיו נקודת ה-create הציבורית היא endpoint פתוח לכתיבה — גם וקטור
# להרעלת המאגר וגם לזיהוי מבנהו.
#
# 🔴 האכיפה עצמה מוגדרת **בקונסולה, לא ב-rules ולא כאן.**
#    Firebase Console → App Check → Firestore → Enforce.
#    זה פריט DoD שעדי מאמתת בצילום מסך.
# ----------------------------------------------------------------------------
VITE_APPCHECK_SITE_KEY=

# טוקן דיבאג לפיתוח מקומי (Console → App Check → Manage debug tokens).
# **לא למלא בפרודקשן.**
VITE_APPCHECK_DEBUG_TOKEN=
