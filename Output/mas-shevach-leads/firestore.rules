rules_version = '2';

// ============================================================================
// 🔴🔴 לקרוא לפני שנוגעים בקובץ הזה.
//
// **כללי Firebase הם אדיטיביים. אין `deny`.**
// התוצאה היא ה-OR של **כל** כלל שמתאים לנתיב. כלל ספציפי מחמיר **אינו**
// גובר על כלל רחב מתיר — הוא פשוט חסר משמעות לידו.
//
// לכן: **אסור `match /{document=**}` מתיר בשום מקום.** "ליתר ביטחון"
// ב-rules הוא תמיד ההפך מביטחון. ב-NRCAR כלל רחב אחד ביטל בשקט את כל בידוד
// המסמכים האישיים, ולא נתפס בשום code review — רק בהרצה מול אמולטור.
//
// ⚠️ אימות: `npm run emu:rules` (25 אסרשנים). הוא **תנאי סף לשער של עדי**,
//    לא נחמד-שיהיה. שינוי בקובץ הזה בלי הרצה מחדש = שינוי לא מאומת.
// ============================================================================

// ============================================================================
// ההקשר שקובע את הקובץ הזה (עדי, 2026-08-15, S5):
//
//   "**כאן ה-rules הן ההגנה היחידה, לא שכבה נוספת.**
//    אין ת.ז. ואין סכומים שאפשר להוריד — אז כל התקציב ההגנתי יושב
//    בבקרת הגישה."
//
// המאגר הזה הוא רשימה של אנשים שמכרו נכס לאחרונה ושילמו מס גבוה. הוא נופל
// תחת "מידע בעל רגישות מיוחדת" בשני מסלולים בלתי-תלויים (תיקון 13, פרט (10)
// נתוני פעילות כלכלית + פרט (11) מידע החייב בסודיות לפי דין — חובת הסודיות
// של מייצג חלה גם על "לקוח בכוח"). ויש לו וקטור תקיפה קונקרטי ומתועד:
// "עוקץ החזרי מס". דליפה כאן אינה מבוכה — היא הנשק.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // 🔴 R-4 — בקרת גישה לפי זהות מפורשת, **לא** `request.auth != null`.
    //
    // זה בדיוק החוסם שעדי תפסה ב-basketball: "מחובר" אינו "מורשה". כל אדם
    // עם חשבון Google הוא `request.auth != null`. במאגר הזה זה אומר שכל
    // בעל חשבון גוגל בעולם קורא את רשימת הלידים.
    //
    // שני מסלולים, שניהם מפורשים:
    //   1. custom claim `role == 'owner'` — המסלול המועדף, נקבע ע"י
    //      `npm run grant:owner` (Admin SDK). לא ניתן לזיוף מהקליינט.
    //   2. allowlist מיילים מפורש למטה — לצורך ההקמה הראשונית, לפני
    //      שיש claim. **חייב `email_verified`.**
    //
    // ⚠️ ה-allowlist מגיע עם placeholder. `npm run check` **נכשל** אם
    //    ה-placeholder עדיין כאן — אי אפשר לפרסם rules בלי בעלים אמיתי.
    // ========================================================================
    function ownerEmails() {
      return [
        'moshe@moshebm.co.il'
      ];
    }

    function isOwner() {
      return request.auth != null
        && (
          request.auth.token.get('role', '') == 'owner'
          || (
            request.auth.token.get('email_verified', false) == true
            && request.auth.token.get('email', '') in ownerEmails()
          )
        );
    }

    // ========================================================================
    // ולידציה של ליד חדש — R-2 (allowlist) + R-3 (טיפוסים ואורכים)
    // ========================================================================

    // 🔴 R-2 — hasOnly הוא מה שהופך את "אין ת.ז." מהחלטה למנגנון.
    // בלעדיו, כל אחד שפותח DevTools כותב `{idNumber: "..."}` ל-`leads`.
    // 🔴 `policyVersion` הוא שדה **עליון**, ולא בתוך `source`.
    //    הגרסה הראשונה קברה אותו שם, וזה היה שגוי: `source` הוא ייחוס
    //    שיווקי, ו-`policyVersion` הוא **ראיה להסכמה**. ג'וב שינקה ייחוס
    //    שיווקי אחרי N חודשים היה מוחק בשקט את ראיית ההסכמה יחד איתו.
    //    שני דברים עם מחזורי חיים שונים לא יושבים באותו שדה.
    function hasOnlyAllowedKeys(d) {
      return d.keys().hasOnly(
        ['firstName', 'phone', 'email', 'screened', 'source', 'policyVersion', 'createdAt']
      ) && d.keys().hasAll(['firstName', 'phone', 'policyVersion', 'createdAt']);
    }

    // 🔴 R-3 — מגבלות אורך וטיפוס, אחרת `firstName` הופך לשדה טקסט חופשי.
    //
    // תוספת מעבר למפרט של עדי, ומכוונת: **`firstName` אינו מקבל ספרות.**
    // תקרת 40 תווים לבדה עדיין מאפשרת "יוסי ת.ז 123456789". ת.ז. ישראלית
    // היא תשע ספרות; חסימת ספרות בשדה החופשי-למחצה היחיד חוסמת את הווקטור
    // מבנית ולא בהסתברות. מותרים: אותיות עברית ולטינית, רווח, מקף, גרש.
    //
    // 🔴 **פסילת ספרות, לא allowlist תווים** — וזו לא בחירת סגנון.
    //    הגרסה הראשונה כאן הייתה allowlist (עברית + לטינית). היא דחתה
    //    `محمد`, `سارة` ו-`Дмитрий` — כלומר חסמה בשקט חלק ניכר מהאוכלוסייה
    //    בישראל. **שם תקין שנדחה = ליד אבוד**, וכאן גם הפליה בתוצאה.
    //    denylist משיג את אותה מטרה בדיוק (אי אפשר להסתיר ת.ז. בלי ספרות)
    //    בלי להניח הנחות על האלפבית של אף אחד.
    //
    // ⚠️ התווים כתובים כאן **מילולית ב-UTF-8** ולא כ-`\uXXXX`. מנוע ה-RE2
    //    של Firestore דוחה בקומפילציה תבנית עם escapes מסוג `\u`, וההודעה
    //    שהוא מחזיר היא "Invalid regular expression pattern" בלי לרמוז למה.
    //    זה נתפס רק בהרצה מול אמולטור — לא בקריאה ולא ב-lint.
    //
    //    המחלקה שוללת גם ספרות ערביות-הודיות (٠-٩) ומורחבות (۰-۹), אחרת
    //    ת.ז. נכתבת בהן ועוברת. `\n\r\t` נשללים כדי שהשדה לא יהפוך לרב-שורתי.
    function validName(v) {
      return v is string
        && v.size() >= 2
        && v.size() <= 40
        && v.matches("[^0-9٠-٩۰-۹\\n\\r\\t]{2,40}");
    }

    // טלפון ישראלי: קווי (9 ספרות) או נייד (10). הנוסח של עדי, R-3.
    function validPhone(v) {
      return v is string && v.matches('^0[2-9][0-9]{7,8}$');
    }

    // אימייל — **אופציונלי** (עדי S3: "אם יש טלפון, אימייל אינו הכרחי").
    // אם קיים, חייב להיות תקין. שדה ריק נשלח כהשמטה, לא כמחרוזת ריקה.
    function validEmailField(d) {
      return !('email' in d)
        || (d.email is string
            && d.email.size() >= 5
            && d.email.size() <= 100
            && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'));
    }

    // ========================================================================
    // `source` — ייחוס שיווקי בלבד. **ארבעה שדות שאנחנו קובעים, וזהו.**
    //
    // 🔴 הדפוס, ולא רק המופע: שדה טקסט חופשי **מהמשתמש** שנכנס דרך שכבת
    //    האנליטיקס עוקף את S3 בדלת צדדית — בלי ששום שדה טופס נפתח.
    //    ארבעה מופעים נחסמים כאן:
    //
    //    ❌ `utmTerm`   — מילת החיפוש שהמשתמש הקליד. בקמפיין הזה זה עלול
    //                     להיות "מכרתי דירה ושילמתי 240 אלף מס".
    //    ❌ `referrer`  — ה-referrer המלא נושא את שאילתת מנוע החיפוש המפנה.
    //    ❌ `landingUrl`— ה-URL המלא עם ה-query string, מאותה סיבה.
    //    ❌ `gclid`/`fbclid` — מזהי קליק שמקשרים את הליד לפרופיל שלו אצל
    //                     Google/Meta. הצידוק היחיד להחזיק בהם הוא ייבוא
    //                     המרות אופליין — **שנחסם ב-S11(1)**. כלומר הם
    //                     נושאים סיכון קישור בלי שום שימוש מותר.
    //                     **מה שאין לו שימוש מותר — לא נאסף.**
    //
    //    ✅ utmSource/Medium/Campaign/Content נשארים: אנחנו קובעים אותם,
    //       לא המשתמש.
    // ========================================================================
    function validSourceField(d) {
      return !('source' in d)
        || (
          d.source is map
          && d.source.keys().hasOnly(['utmSource', 'utmMedium', 'utmCampaign', 'utmContent'])
          && (!('utmSource' in d.source) || (d.source.utmSource is string && d.source.utmSource.size() <= 64))
          && (!('utmMedium' in d.source) || (d.source.utmMedium is string && d.source.utmMedium.size() <= 64))
          && (!('utmCampaign' in d.source) || (d.source.utmCampaign is string && d.source.utmCampaign.size() <= 64))
          && (!('utmContent' in d.source) || (d.source.utmContent is string && d.source.utmContent.size() <= 64))
        );
    }

    function isValidLead(d) {
      return hasOnlyAllowedKeys(d)
        && validName(d.firstName)
        && validPhone(d.phone)
        && validEmailField(d)
        && validSourceField(d)
        // ראיית ההסכמה (ס' 11 / ס' 30א). הסכמה בלי חותמת חסרת ערך ראייתי.
        // אין צורך ב-`optInAt` נפרד: הטופס נשלח פעם אחת, ולכן `createdAt`
        // (שהוא זמן שרת) הוא גם מועד ההסכמה.
        && d.policyVersion is string
        && d.policyVersion.size() > 0
        && d.policyVersion.size() <= 32
        // 🔴 `screened` הוא בוליאני **יחיד**. ארבע תשובות הבודק כערכים
        //    נפרדים הן "תיק מס מזערי" (עדי S3) — והן חסומות ע"י hasOnly.
        && (!('screened' in d) || d.screened is bool)
        // 🔴 R-3 — createdAt חייב להיות זמן השרת. חותמת שנשלטת ע"י הקליינט
        //    מאפשרת להזיז ליד אל מחוץ לחלון המחיקה של S8.
        && d.createdAt == request.time;
    }

    // ========================================================================
    // leads — נקודת הכתיבה הציבורית היחידה במערכת.
    //
    // 🔴 R-1: `update, delete: if false` — **גם למשה.**
    // כל שינוי סטטוס וכל מחיקה עוברים דרך Cloud Function (Admin SDK, עוקף
    // rules). התוצאה: דפדפן שנפרץ, או session גנוב של משה, לא יכול לדרוס
    // נתונים, לזייף סטטוס או למחוק את המאגר. הוא יכול רק לקרוא.
    //
    // ⚠️ מה שהכלל הזה **לא** עושה: הוא לא מגן על התוכן מפני ה-Function.
    //    ה-Function רצה ב-Admin SDK ועוקפת rules לחלוטין. משמעת השדות שם
    //    נאכפת בקוד ובבדיקות — לא כאן. אל תיקחו נחמה מהכלל.
    // ========================================================================
    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow get, list: if isOwner();
      allow update, delete: if false;
    }

    // ========================================================================
    // suppression — רשומות דיכוי של מי שסירב (עדי S8(4)).
    //
    // "מחיקה מלאה של מסרב היא הזמנה לפנות אליו שוב." לכן נשמרת רשומה
    // מינימלית — **בלי שם ובלי הקשר**.
    //
    // 🔴 חיזוק מעבר למפרט: עדי כתבה "טלפון + optedOut + תאריך". כאן מזהה
    //    המסמך הוא **HMAC-SHA256 של הטלפון** עם סוד שיושב בשרת בלבד, והטלפון
    //    עצמו אינו נשמר. הסיבה: רשימת טלפונים של מי שפנה לשירות החזרי מס
    //    שבח היא בעצמה בדיוק המידע הרגיש שסעיף 0(1) מדבר עליו — "התוכן
    //    הרגיש הוא ההשתייכות למאגר, לא השדה". גיבוב שומר על כל התפקוד
    //    (בדיקת "האם מספר זה סירב") ומאפס את ערך הדליפה.
    //
    // הקליינט **לא קורא ולא כותב** כאן כלל. שרת בלבד.
    // ========================================================================
    match /suppression/{phoneHash} {
      allow read, write: if false;
    }

    // ========================================================================
    // 🔴 M4 — אוסף הדיוור **הוסר לגמרי** (שער עדי, סבב 3).
    //
    // היה כאן `marketingSubscribers`. הוא ירד יחד עם תיבת ה-opt-in, ולא
    // מטעמי ניסוח: התיבה הבטיחה מסרונים בזמן שנשמר אימייל בלבד, האימייל
    // אופציונלי ולכן הסכמות נפלו בשקט, ולא היה מנגנון הסרה בקוד כלל.
    // **עדיף לא לאסוף מאשר לאסוף חלקית** — הסכמה שלא ניתן לממש או לחזור
    // ממנה גרועה מאי-איסוף, כי היא יוצרת מצג של הסכמה.
    //
    // ⚠️ אין כאן `match` "ליתר ביטחון". הכלל הסוגר `/{document=**}` חוסם
    //    את הנתיב ממילא, וכלל מיותר הוא בדיוק מה שהופך בטעות למתיר.
    //    כשיהיה דיוור אמיתי — סבב חדש אצל עדי, לא החזרת שורות.
    // ========================================================================

    // ========================================================================
    // opsLog — יומן פעולות של משה על המאגר (תקנות אבטחת מידע 2017, R-7:
    // "תיעוד גישה"). נכתב ע"י ה-Function בלבד; משה קורא כדי שיוכל להציג
    // אותו בביקורת.
    // ========================================================================
    match /opsLog/{entryId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // -- כל השאר: חסום מפורשות ---------------------------------------------
    // deny-by-default. זה הכלל האחרון והוא **חוסם**, לא מתיר.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
