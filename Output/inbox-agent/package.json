{
  "name": "inbox-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ההזמנות של היום — רשימת אריזה שנקראת מהודעות התשלום. מקומי, על fixtures. בלי גוגל, בלי ענן, ובלי מודל.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-no-model.mjs && node scripts/check-order-source.mjs && node scripts/check-order-logging.mjs && tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:orders": "node scripts/check-order-logging.mjs",
    "check:no-model": "node scripts/check-no-model.mjs",
    "check:source": "node scripts/check-order-source.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.5"
  }
}
