rules_version = '2';

// ============================================================================
// firestore.rules — deny-all, וכל כתיבה עוברת ב-Admin SDK.
//
// ---------------------------------------------------------------------------
// העיקרון, ולמה הוא חזק יותר מכללי כתיבה מפורטים
// ---------------------------------------------------------------------------
// אין כאן שום `allow write`. אף אחד. הקליינט **קורא** את מה ששייך לו ולא
// כותב כלום — כל כתיבה עוברת ב-Cloud Function שרצה ב-Admin SDK ועוקפת את
// הכללים. אותה הכרעה בדיוק כמו ב-hachzarei-mas, ומאותו טעם: כלל כתיבה
// מפורט הוא ניסוח מחדש של הוולידציה בצד השרת, בשפה אחרת, בקובץ אחר —
// והשניים סוטים זה מזה בדיוק ברגע שמישהו מתקן אחד מהם.
//
// מה שהמבנה הזה קונה כאן במיוחד: **`recipientPurged` לא ניתן לזיוף מהקליינט,
// ו-`purgeAfter` לא ניתן לדחייה.** אילו הקליינט יכול היה לכתוב, מדיניות
// המחיקה הייתה נתונה לשליטת הדפדפן.
//
// ---------------------------------------------------------------------------
// ⛔ `oauthTokens` — `if false` מוחלט
// ---------------------------------------------------------------------------
// **גם לבעלים.** זה נראה מוזר — זה הטוקן שלה — ולכן כתוב כאן למה: אין שום
// מסך שצריך את הערך הזה, ואין שום פעולה בקליינט שנעשית איתו. מה שהמסך צריך
// לדעת הוא **האם** מחובר, וזה שדה נפרד (`googleConnection`) על מסמך המשתמש.
//
// הרשאת קריאה שאיש לא צריך היא בדיוק "זה לא אמור לרוץ" בשכבת ההרשאות (B6),
// והפריט הזה הוא המפתח לתיבה עצמה. `if false` הוא הכלל היחיד שאין לו מקרה
// קצה.
//
// ---------------------------------------------------------------------------
// A5′ — מה שהבדיקות ב-`rules-tests/` מוכיחות
// ---------------------------------------------------------------------------
//  · `oauthTokens` חסום — גם לבעלים, גם למשתמש אחר, גם ללא-מחובר.
//  · כתיבה מקליינט חסומה בכל אוסף.
//  · משתמש אחר אינו קורא `orders` של הבעלים.
//  · `{document=**}` חסום — אוסף חדש שיתווסף בלי כלל **לא** נגיש.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // ⛔ ה-`state` של זרימת ההרשאה. אוסף שורש, ואיש לא נוגע בו מהקליינט.
    // הוא מחזיק את ה-uid, והוא מה שקושר בין הקולבק לזהות — ערך שאפשר
    // לקרוא הוא ערך שאפשר לזייף מולו.
    // ------------------------------------------------------------------
    match /oauthStates/{state} {
      allow read, write: if false;
    }

    match /users/{uid} {

      // ------------------------------------------------------------------
      // מסמך המשתמשת עצמו: `googleConnection`, `supportMode`, מוני הקריאה.
      // **קריאה לבעלים בלבד.** אין `allow write` — גם `supportMode` נכתב
      // דרך `setSupportMode`, כדי שהפקיעה תחושב בשרת ולא בדפדפן.
      // ------------------------------------------------------------------
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      // ------------------------------------------------------------------
      // ⛔⛔ הטוקן. **`if false` מוחלט.** ראה ההערה למעלה.
      //
      // ⚠️ ולמה זה לא מספיק לבדו, וחשוב לדעת את זה: כללי Firestore מצטברים
      // ב-**OR**, ו-`if false` **אינו** מבטל `allow` אחר. אילו היה כאן
      // במקום כלשהו כלל רחב מסוג
      //     match /users/{uid}/{doc=**} { allow read: if request.auth.uid == uid; }
      // הוא היה מתיר גם את האוסף הזה, והשורה למטה לא הייתה משנה כלום.
      //
      // ההגנה האמיתית היא ש**אין** כלל רחב כזה בקובץ: כל אוסף מקבל כלל
      // מפורש משלו. השורה למטה היא הצהרת כוונה קריאה, לא המנגנון — והמנגנון
      // נבדק ב-`rules-tests/`, שם גם רץ המקרה "משתמש אחר קורא oauthTokens".
      // ------------------------------------------------------------------
      match /oauthTokens/{docId} {
        allow read, write: if false;
      }

      // ------------------------------------------------------------------
      // ההזמנות. קריאה לבעלים, כתיבה — לאף אחד.
      // ------------------------------------------------------------------
      match /orders/{orderId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // "ההזמנות של היום" — מזהים בלבד. אותו כלל.
      match /dailyLists/{listId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // ★ B3′.2 — יומן הגישה. **דורית חייבת לקרוא אותו**, אחרת הוא לא
      // תיעוד עבורה. כתיבה — רק Admin.
      match /accessLog/{entryId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // ריצות סנכרון ומחיקה: ספירות וקודים, בלי תוכן. קריאה לבעלים.
      match /syncRuns/{runId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // ------------------------------------------------------------------
      // ⛔ וכל תת-אוסף אחר תחת המשתמשת?
      //
      // **חסום, ובלי שכתבנו לו כלל** — כי ברירת המחדל ב-Firestore היא סירוב,
      // ורק `allow` מפורש פותח. אין כאן `match /{sub=**} { allow ...: if false }`
      // בכוונה: כלל כזה נראה כאילו הוא חוסם, ובפועל הוא no-op גמור (כללים
      // מצטברים ב-OR — ראה למעלה). שורה שנראית כמו בקרה ואינה בקרה היא בדיוק
      // מה שגורם לאיש לא לבדוק אם יש בקרה.
      //
      // המשמעות המעשית: אוסף חדש שמישהו יוסיף בקוד ולא כאן — לא ייקרא
      // מהקליינט. הכיוון הבטוח: פיצ'ר שלא עובד, ולא מידע שנחשף.
      // ------------------------------------------------------------------
    }

    // ------------------------------------------------------------------
    // ⛔ ברירת המחדל.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
