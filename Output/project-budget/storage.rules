rules_version = '2';

// ============================================================================
// storage.rules — קבצי החשבוניות.
//
// הקבצים יושבים תחת `projects/{pid}/documents/{docId}/{file}` — אותו בידוד-
// לפי-נתיב כמו ב-Firestore. ההרשאה נקראת ממסמך הפרויקט ב-Firestore דרך
// `firestore.get`, כדי שיהיה **מקור אמת אחד** לתפקידים ולא שתי רשימות שנפרדות.
//
// חשבונית של ספק היא מידע עסקי של צד שלישי. הכלל כאן הוא deny-by-default,
// והמחיקה שמורה לבעלים בלבד: חברת הניהול מעלה מסמכים, לא מוחקת ראיות.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function project(pid) {
      return firestore.get(/databases/(default)/documents/projects/$(pid)).data;
    }

    function roleIn(pid) {
      return firestore.exists(/databases/(default)/documents/projects/$(pid))
        && project(pid).memberRoles is map
        && project(pid).memberRoles[email()] is string
        ? project(pid).memberRoles[email()]
        : '';
    }

    function isMember(pid) { return signedIn() && roleIn(pid) != ''; }
    function isOwner(pid)  { return signedIn() && roleIn(pid) == 'owner'; }
    function canUpload(pid) {
      return signedIn() && (roleIn(pid) == 'owner' || roleIn(pid) == 'manager');
    }

    match /projects/{pid}/documents/{docId}/{fileName} {
      allow read: if isMember(pid);

      // 20MB תקרה, ורק סוגי קבצים שחשבונית באמת מגיעה בהם. בלי זה האחסון
      // הופך לדיסק ציבורי לכל מי שיש לו גישה לפרויקט.
      allow create, update: if canUpload(pid)
                            && request.resource.size < 20 * 1024 * 1024
                            && (request.resource.contentType.matches('application/pdf')
                                || request.resource.contentType.matches('image/.*'));

      allow delete: if isOwner(pid);
    }
  }
}
