# ── מזהי מדידה ─────────────────────────────────────────────
# ריקים = הסקריפטים לא נטענים בכלל, והאתר עובד רגיל.
VITE_GA4_ID=
VITE_META_PIXEL_ID=

# ── נקודת הקצה של שליחת הליד ────────────────────────────────
# בפרודקשן משאירים ריק: הנתיב /api/submit-lead מנותב ב-firebase.json
# אל הפונקציה, והבקשה נשארת same-origin (בלי CORS).
# בפיתוח מקומי vite.config.ts מנתב אותו לאמולטור — ראה README.
VITE_SUBMIT_LEAD_URL=
