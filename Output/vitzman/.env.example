# ============================================================================
# Firebase — אופציונלי. בלי הקובץ הזה האפליקציה רצה במצב מקומי (localStorage),
# וזה מספיק כדי לעבוד עם כל 131 הבניינים היום.
# העתק ל-.env ומלא מ-Firebase Console → Project settings → Your apps → Web app.
# ============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# מזהה הארגון בנתיב Firestore (`orgs/<כאן>/...`). ברירת המחדל `vitzman`.
VITE_ORG_ID=vitzman
