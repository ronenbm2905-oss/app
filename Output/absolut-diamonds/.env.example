# העתיקו לקובץ בשם .env (בלי סיומת) ומלאו מהקונסולה של Firebase.
# ⚠️ המפתחות האלה ציבוריים ממילא (הם נצרבים לתוך ה-build) —
#    ההגנה האמיתית היא firestore.rules ו-storage.rules.
# ⚠️ כל שינוי כאן מחייב `npm run build` מחדש.
# ⚠️ בלי הקובץ הזה האפליקציה רצה במצב מקומי (localStorage) עם נתוני דמו.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
