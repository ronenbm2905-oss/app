# --- סודות ומשתני סביבה ---
.env
.env.local
.env.*.local

# הקובץ .env.example כן נשמר ב-git
!.env.example

# --- תלויות ---
node_modules/
__pycache__/
*.pyc
venv/
.venv/

# --- לוגים וקבצים זמניים ---
*.log
logs/
tmp/
.cache/

# --- קבצי מערכת ---
.DS_Store
Thumbs.db

# --- קבצי עורך/IDE ---
.vscode/
.idea/
*.swp

# --- חומר רגיש: הריפו הזה ציבורי ---
# תמונות מקור של מתאמני Run2dream + תעודת ההסמכה של משה (מכילה ת.ז.)
itai/Outputs/run2dream/
# צילומי מרוצים — זכויות של צלם רשמי, ירדו מהדף
itai/Outputs/run2dream-web/
# קובץ הרכבים האמיתי של פרויקט הליסינג
# --- גיליונות עבודה בשורש הריפו ---
# הריפו הזה פאבליק. גיליונות שנוחתים בשורש הם קבצי עבודה אמיתיים — שכר, רכבים,
# רשימות שחקנים — ולא קוד. חוסמים אותם כקטגוריה, לא אחד-אחד.
# תבניות ודוגמאות שכן צריכות להיות בגיט — לשים תחת Output/ או data/.
/*.xlsx
/*.xls
/*.csv
.tmp-logo/
.tmp-preview/

# --- עותקי עבודה מקוננים ---
# .saas-review הוא clone מלא עם .git משלו (~693MB). ריפו בתוך ריפו = צרות.
.saas-review/
Output/project-budget/
